<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="fc score uwu"/>
        <attribute name="authors" value="Ma. Gia"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-05 02:46:47 PM"/>
        <attribute name="created" value="TWEuIEdpYTtHSUE7MjAyNi0wOS0wNTswMjozNTo0NiBQTTsyMDIy"/>
        <attribute name="edited" value="TWEuIEdpYTtHSUE7MjAyNi0wOS0wNTswMjo0Njo0NyBQTTsxOzIxMzM="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;Enter score:&quot;" newline="True"/>
            <declare name="score" type="Integer" array="False" size=""/>
            <input variable="score"/>
            <if expression="score &lt; 0 or score &gt; 100">
                <then>
                    <output expression="&quot;Invalid Score&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="score &gt;= 90">
                        <then>
                            <output expression="&quot;Outstanding&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="score &gt;= 80">
                                <then>
                                    <output expression="&quot;Very Satisfactory&quot;" newline="True"/>
                                </then>
                                <else>
                                    <if expression="score &gt;= 75">
                                        <then>
                                            <output expression="&quot;Satisfactory&quot;" newline="True"/>
                                        </then>
                                        <else>
                                            <output expression="&quot;Needs Improvement&quot;" newline="True"/>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
